rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: debe coincidir con CONFIG.admins en js/config.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'manumarcas9711@gmail.com';
    }

    function validDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'email', 'foto', 'asiste', 'bebidas', 'actualizado'])
        && d.keys().hasAll(['asiste', 'bebidas'])
        && d.asiste is bool
        && d.bebidas is list
        && d.bebidas.size() <= 8
        && d.bebidas.hasOnly(['agua', 'cocacola', 'vermut', 'cerveza', 'ginebra', 'ron', 'whisky', 'vodka'])
        && (!('nombre' in d) || (d.nombre is string && d.nombre.size() <= 120))
        && (!('email' in d) || (d.email is string && d.email.size() <= 200))
        && (!('foto' in d) || d.foto == null || (d.foto is string && d.foto.size() <= 500));
    }

    // Cada persona escribe/lee SOLO su respuesta (el id del documento es su uid).
    // El administrador puede leer todas.
    match /respuestas/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid && validDoc();
      allow delete: if isAdmin();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
