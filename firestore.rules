rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: debe coincidir con CONFIG.admins en js/config.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['manumarcas9711@gmail.com', 'jlimens@umh.es'];
    }

    // Acompañantes permitidos para cada destilado
    function validMix(m) {
      let ok = ['cocacola', 'fanta_naranja', 'fanta_limon', 'tonica'];
      return m.keys().hasOnly(['ginebra', 'ron', 'whisky', 'vodka'])
        && (!('ginebra' in m) || (m.ginebra is list && m.ginebra.size() <= 4 && m.ginebra.hasOnly(ok)))
        && (!('ron' in m)     || (m.ron is list     && m.ron.size() <= 4     && m.ron.hasOnly(ok)))
        && (!('whisky' in m)  || (m.whisky is list  && m.whisky.size() <= 4  && m.whisky.hasOnly(ok)))
        && (!('vodka' in m)   || (m.vodka is list   && m.vodka.size() <= 4   && m.vodka.hasOnly(ok)));
    }

    function validDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'email', 'foto', 'asiste', 'bebidas', 'mezclas', 'actualizado'])
        && d.keys().hasAll(['asiste', 'bebidas'])
        && d.asiste is bool
        && d.bebidas is list
        && d.bebidas.size() <= 8
        && d.bebidas.hasOnly(['agua', 'cerveza', 'vino', 'vermut', 'ginebra', 'ron', 'whisky', 'vodka'])
        && (!('mezclas' in d) || (d.mezclas is map && validMix(d.mezclas)))
        && (!('nombre' in d) || (d.nombre is string && d.nombre.size() <= 120))
        && (!('email' in d) || (d.email is string && d.email.size() <= 200))
        && (!('foto' in d) || d.foto == null || (d.foto is string && d.foto.size() <= 500));
    }

    // Cualquier invitado con sesión puede VER las respuestas ("Ver votaciones"),
    // pero cada persona solo escribe la suya (el id del documento es su uid).
    match /respuestas/{uid} {
      allow read: if request.auth != null;   // cualquier invitado con sesión puede ver las votaciones
      allow create, update: if request.auth != null && request.auth.uid == uid && validDoc();
      // Un administrador solo puede pasar a alguien a "no asiste" (nada más cambia)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asiste', 'actualizado'])
        && request.resource.data.asiste == false;
      // Cada persona puede borrar la suya (botón "Reiniciar"); los admins, cualquiera
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
